# Backend environment variables (.env for FastAPI service)
# WARNING: Never commit real secrets. This file is an example only.

# Service port
PORT=3001

# Supabase project configuration
# IMPORTANT: Do NOT expose the SERVICE ROLE KEY in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional keys (anon for public client operations if needed by backend tasks)
SUPABASE_ANON_KEY=
# Optional: verify JWTs issued by Supabase
SUPABASE_JWT_SECRET=

# CORS configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Optional: OpenAI for AI features (do not hardcode in code)
OPENAI_API_KEY=

# Feature flags (JSON string)
FEATURE_FLAGS={"ai":true,"chat":true}

# Logging
LOG_LEVEL=info
